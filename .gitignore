# Secrets
# `.env*`, not `.env`: a deploy or an edit leaves .env.bak.<timestamp>
# next to it, which the bare pattern did not cover. One `git add -A` and
# the Spotify secret, the cookie secret, the DB URL and three API keys
# are in the history. Negated below for anything meant to be shared.
.env*
!.env.example
.cache
.spotify_token_cache
.cookie_secret
.tmp_token_cache
.soundcloud_token.json
# Logged-in YouTube session for the IG resolve stage (export_yt_cookies.py)
.yt_cookies.txt

# User data
users/
history.json
ledger.json
spotify_raw.json
artist_cache.json
profile.json

# Runtime data files (generated, not committed)
catalog.json
discovery_youtube.json
yt_channels_cache.json
yt_user_channels.json
genre_map.json
track_map.json
data.json
.api_budget.json
*.lock

# Migrated to PostgreSQL (no longer used as files)
discovery.json
artist_db.json
discovered_genres.json
search_history.json
artist_crawl_state.json
# Resume state for the long paced ingests. Dot-prefixed by convention; they
# record only which rows a run already attempted, so a fresh clone should
# start clean rather than inherit another machine's progress.
.curator_ingest_state.json
.bandcamp_ingest_state.json
.curator_bandcamp_state.json
discovery_priorities.json

# Generated data dir (not committed)
data/

# Backups
backups/

# Instagram pipeline media (downloaded audio + rendered cards/mp4s)
media/

# System
__pycache__/
*.pyc
.DS_Store
# Every cron tick rewrote these, so the working tree was permanently dirty and
# real changes hid among log churn. `cron.log` alone missed ig_cron.log and
# audio_analyze.log.
*.log
venv/

# Cron bookkeeping: run lock (also caught by *.lock) and the token-age stamp
# that ig_refresh_token.py uses to decide when to rotate.
.ig_token_refreshed
